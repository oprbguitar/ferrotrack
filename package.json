{
  "name": "ferrotrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema anónimo de monitoreo longitudinal del estado del hierro, con planificación nutricional adaptada al horario real.",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "serve": "python3 -m http.server 8099 --directory site",
    "smoke": "node tests/smoke.mjs http://127.0.0.1:8099/",
    "datos": "python3 scripts/build_food_db.py",
    "datos:online": "python3 scripts/build_food_db.py --online"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
